+/* lima (Mali-400) samples RGB565 textures as black. Widen 16-bit
+ * core frames to RGBA8888 so they ride the well-tested 32-bit path. */
+static void gl2_rgb565_to_rgba8888(uint8_t *dst,
+      const uint16_t *src, unsigned width, unsigned height, size_t pitch)
+{
+   unsigned x, y;
+   for (y = 0; y < height; y++, src += pitch >> 1, dst += (size_t)width << 2)
+   {
+      const uint16_t *s = src;
+      uint8_t *d         = dst;
+      for (x = 0; x < width; x++, s++, d += 4)
+      {
+         uint16_t p = *s;
+         d[0]       = (uint8_t)(((p >> 11) & 0x1f) << 3);
+         d[1]       = (uint8_t)(((p >> 5)  & 0x3f) << 2);
+         d[2]       = (uint8_t)((p & 0x1f) << 3);
+         d[3]       = 0xff;
+      }
+   }
+}
+#endif
 
